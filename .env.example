# Copy to .env for local development:  cp .env.example .env
# (.env is gitignored — never commit real tokens.)

# Slack bot token, starts with "xoxb-". Create at https://api.slack.com/apps
# Required scope: chat:write. Then install the app and invite it to the channel.
SLACK_BOT_TOKEN=xoxb-your-token-here

# Target channel ID (not the #name). In Slack: right-click the channel →
# "View channel details" → the ID is at the bottom (e.g. C0123456789).
SLACK_CHANNEL_ID=C0123456789

# The Food Place location id — trailing number in the menu URL.
FOODPLACE_LOCATION_ID=1

# Timezone for deciding "today" and detecting Fridays.
TIMEZONE=Europe/Copenhagen

# Dish language: "da" or "en".
MENU_LANGUAGE=da

# Set to "false" to hide allergen lines.
SHOW_ALLERGENS=true
